#!/bin/bash
# Managed by Ansible (roles/proxy). Runs after `certbot renew` succeeds.
# Backs up /etc/letsencrypt to S3 (see upload-letsencrypt-to-s3.sh), then
# reloads OpenResty. We reload even if the upload fails, then exit non-zero so
# certbot's hook runner still surfaces it.
upload_failed=0

if ! {{ proxy_cert_upload_script }}; then
  upload_failed=1
  echo "WARNING: Failed to back up renewed certificates to S3" >&2
fi

systemctl reload openresty

if [ "$upload_failed" -ne 0 ]; then
  exit 1
fi
