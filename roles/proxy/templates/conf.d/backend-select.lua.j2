-- Shared backend-selection module for /rpc and /sequencer routes.
-- Static fallback IPs are baked in at template-render time so this works before
-- node-discovery writes its first update.

local _M = {}

local function read_request_body()
    ngx.req.read_body()

    local body = ngx.req.get_body_data()
    if body then
        return body, "memory"
    end

    local body_file = ngx.req.get_body_file()
    if not body_file then
        return nil, "none"
    end

    local file, open_err = io.open(body_file, "rb")
    if not file then
        ngx.log(ngx.ERR, "request_id=", ngx.var.request_id,
            " failed to open buffered request body: ", open_err)
        return nil, "file_open_error"
    end

    local file_body, read_err = file:read("*a")
    file:close()
    if not file_body then
        ngx.log(ngx.ERR, "request_id=", ngx.var.request_id,
            " failed to read buffered request body: ", read_err)
        return nil, "file_read_error"
    end

    return file_body, "file"
end

local function extract_rpc_id(body)
    local _, value_prefix_end = body:find('"id"%s*:%s*')
    if not value_prefix_end then
        return "-"
    end

    local value_start = value_prefix_end + 1
    if body:sub(value_start, value_start) == '"' then
        value_start = value_start + 1
        local value_end = body:find('"', value_start, true)
        if not value_end then
            return "-"
        end
        return body:sub(value_start, math.min(value_end - 1, value_start + 127))
    end

    local scalar_start, _, scalar = body:find("([%w+.-]+)", value_start)
    if scalar_start == value_start then
        return scalar:sub(1, 128)
    end

    return "-"
end

local function extract_raw_tx_bytes(body)
    local _, hex_prefix_end = body:find('"params"%s*:%s*%[%s*"0[xX]')
    if not hex_prefix_end then
        return "-"
    end

    local value_end = body:find('"', hex_prefix_end + 1, true)
    if not value_end then
        return "-"
    end

    return tostring(math.floor((value_end - hex_prefix_end - 1) / 2))
end

local function pick_backend(use_leader, backend_cache)
    if use_leader then
        return backend_cache:get("leader")
            or "{{ proxy_rollup_leader_ip }}:{{ rollup_http_port }}"
    end

    -- Reads: prefer follower_1 (node-discovery output), then follower,
    -- then leader, then the static template fallback.
    return backend_cache:get("follower_1")
        or backend_cache:get("follower")
        or backend_cache:get("leader")
        or "{{ proxy_rollup_follower_ip | default(proxy_rollup_leader_ip, true) }}:{{ rollup_http_port }}"
end

function _M.select(path)
    local method = ngx.var.request_method
    local backend_cache = ngx.shared.backend_cache
    local use_leader = false
    local routing_reason = "default_read"

    ngx.var.rpc_method = "-"
    ngx.var.rpc_id = "-"
    ngx.var.rpc_body_source = "-"
    ngx.var.rpc_body_bytes = "-"
    ngx.var.rpc_raw_tx_bytes = "-"

    -- WebSocket upgrades go to the leader for consistency.
    local is_websocket = ngx.var.http_upgrade
        and ngx.var.http_upgrade:lower() == "websocket"

    if path == "/sequencer/txs" and method == "POST" then
        use_leader = true
        routing_reason = "sequencer_submission"
    elseif path == "/sequencer/ready" and method == "GET" then
        -- Leader health check.
        use_leader = true
        routing_reason = "leader_health_check"
    elseif is_websocket then
        use_leader = true
        routing_reason = "websocket"
    elseif path == "/rpc" and method == "POST" then
        -- Inspect the JSON-RPC body for leader-required methods.
        local body, body_source = read_request_body()
        ngx.var.rpc_body_source = body_source
        if body then
            local rpc_method = body:match('"method"%s*:%s*"([^"]+)"')
            ngx.var.rpc_method = rpc_method or "-"
            ngx.var.rpc_id = extract_rpc_id(body)
            ngx.var.rpc_body_bytes = tostring(#body)
            if rpc_method == "eth_sendRawTransaction"
                or rpc_method == "eth_sendRawTransactionSync"
                or rpc_method == "realtime_sendRawTransaction" then
                use_leader = true
                routing_reason = "rpc_submission"
                ngx.var.rpc_raw_tx_bytes = extract_raw_tx_bytes(body)
            elseif rpc_method then
                routing_reason = "rpc_read"
            else
                routing_reason = "rpc_method_uninspectable"
            end
        else
            routing_reason = "rpc_body_uninspectable"
        end
        -- Keep uninspectable requests on the normal read-routing path rather
        -- than explicitly selecting the leader for an unknown method.
    end

    ngx.var.routing_class = use_leader and "leader" or "read"
    ngx.var.routing_reason = routing_reason
    ngx.var.backend = pick_backend(use_leader, backend_cache)
end

return _M
